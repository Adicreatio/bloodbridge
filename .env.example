# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth Redirect URL
# For local development:
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# For production, update the above URL to:
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=https://yourdomain.com/auth/callback

# Google OAuth (Set up in Supabase - not needed as env var)
# These are configured directly in Supabase dashboard:
# - Google Client ID
# - Google Client Secret
